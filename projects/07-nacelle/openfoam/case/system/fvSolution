/*--------------------------------*- C++ -*----------------------------------*\
  rhoSimpleFoam SIMPLE-loop settings, matched to OpenFOAM's own external-
  aerodynamics reference case (compressible/rhoSimpleFoam/aerofoilNACA0012)
  after a first, more conservative-looking attempt (consistent yes / SIMPLEC
  with LOW p relaxation) actually diverged into a floating-point exception
  in GAMG by the second iteration -- caught by running it, not predicted.
  consistent yes wants HIGH p relaxation, not low; mixing SIMPLEC with a
  SIMPLE-style low p relaxation was the likely mismatch. Plain SIMPLE
  (no `consistent`) with the tutorial's own relaxation factors below, plus
  pMinFactor/pMaxFactor bounding the pressure correction, is what's here now.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.01;
    }

    "(U|h|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }

    Phi
    {
        // Only used by potentialFoam, run once to initialise U/p from an
        // irrotational solve before rhoSimpleFoam -- a standard technique
        // for keeping the first few SIMPLE iterations from blowing up on
        // a uniform initial guess.
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.01;
    }
}

SIMPLE
{
    residualControl
    {
        p               1e-4;
        U               1e-4;
        h               1e-4;
        "(k|omega)"     1e-4;
    }

    nNonOrthogonalCorrectors 0;
    pMinFactor      0.1;
    pMaxFactor      2;
}

relaxationFactors
{
    fields
    {
        p               0.7;
        rho             0.01;
    }
    equations
    {
        U               0.3;
        h               0.7;
        "(k|omega)"     0.7;
    }
}

