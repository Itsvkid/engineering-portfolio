/*--------------------------------*- C++ -*----------------------------------*\
  Turbulent thermal diffusivity — calculated everywhere except the wall.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat;
}

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    farFieldInlet
    {
        type            calculated;
        value           uniform 0;
    }
    farFieldOutlet
    {
        type            calculated;
        value           uniform 0;
    }
    farFieldSide
    {
        type            calculated;
        value           uniform 0;
    }
    cowlAndAfterbody
    {
        type            compressible::alphatWallFunction;
        Prt             0.85;
        value           uniform 0;
    }
    highlightInlet
    {
        type            calculated;
        value           uniform 0;
    }
}

