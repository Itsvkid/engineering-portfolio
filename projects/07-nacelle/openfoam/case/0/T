/*--------------------------------*- C++ -*----------------------------------*\
  Freestream static temperature 288.15 K — the CHOSEN input in
  freestream_conditions.py (ISA sea-level; the report gives Re/ft and M,
  not a temperature — see that module's docstring).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 288.15;

boundaryField
{
    farFieldInlet
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
    farFieldOutlet
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
    farFieldSide
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
    cowlAndAfterbody
    {
        type            zeroGradient;
    }
    highlightInlet
    {
        type            inletOutlet;
        inletValue      uniform 288.15;
        value           uniform 288.15;
    }
}

