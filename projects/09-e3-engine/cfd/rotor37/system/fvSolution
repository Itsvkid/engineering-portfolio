FoamFile{version 2.0; format ascii; class dictionary; object fvSolution;}
solvers
{
    p    { solver GAMG; tolerance 1e-9; relTol 0.02; smoother GaussSeidel;
           nPreSweeps 0; nPostSweeps 2; cacheAgglomeration on;
           agglomerator faceAreaPair; nCellsInCoarsestLevel 100; mergeLevels 1; }
    "(U|h|e|k|omega)" { solver PBiCGStab; preconditioner DILU;
                        tolerance 1e-9; relTol 0.05; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    residualControl { p 1e-5; U 1e-5; h 1e-5; "(k|omega)" 1e-4; }
    pMinFactor 0.1;  pMaxFactor 3;
}
relaxationFactors
{
    fields   { p 0.2; rho 0.02; }
    equations { U 0.3; e 0.3; h 0.3; "(k|omega)" 0.3; }
}
