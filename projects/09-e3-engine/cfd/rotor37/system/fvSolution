FoamFile{version 2.0; format ascii; class dictionary; object fvSolution;}
solvers { "(p|rho)" { solver GAMG; tolerance 1e-8; relTol 0.05; smoother GaussSeidel; }
          "(U|e|h|k|omega)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-8; relTol 0.1; } }
SIMPLE  { nNonOrthogonalCorrectors 0; consistent yes;
          residualControl { p 1e-4; U 1e-4; e 1e-4; "(k|omega)" 1e-4; } }
relaxationFactors { equations { ".*" 0.9; } }
