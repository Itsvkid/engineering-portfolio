FoamFile{version 2.0; format ascii; class volScalarField; object omega;}
dimensions [0 0 -1 0 0 0 0];
internalField uniform 2000;
boundaryField
{
    inlet   { type turbulentMixingLengthFrequencyInlet; mixingLength 0.005; value uniform 2000; }
    outlet  { type inletOutlet; inletValue uniform 2000; value uniform 2000; }
    "(hub_rotating|hub_static|blade|casing)" { type omegaWallFunction; value uniform 2000; }
    periodic_m { type cyclic; }
    periodic_p { type cyclic; }
}
