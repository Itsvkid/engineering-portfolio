FoamFile{version 2.0; format ascii; class volScalarField; object k;}
dimensions [0 2 -2 0 0 0 0];
internalField uniform 10;
boundaryField
{
    inlet   { type turbulentIntensityKineticEnergyInlet; intensity 0.02; value uniform 10; }
    outlet  { type inletOutlet; inletValue uniform 10; value uniform 10; }
    "(hub_rotating|hub_static|blade|casing)" { type kqRWallFunction; value uniform 10; }
    periodic_m { type cyclic; }
    periodic_p { type cyclic; }
}
