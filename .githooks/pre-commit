#!/bin/sh
# Refuse a commit that would leave the E3 project's generated documents stale.
#
# Every "E3 engine CI" failure on main has the same two test names in it:
# test_readme.py::test_the_generated_block_is_current and
# test_findings.py::test_findings_md_exists_and_is_current. Nobody broke them
# on purpose. README.md's generated block quotes the project's test-function
# count, its closure states and its figure list; FINDINGS.md is built from
# every STEP0.md. So adding one test function, or closing one closure,
# invalidates a document in a directory the commit never opened -- and the
# news arrives sixteen minutes later, from CI, on a push already made.
#
# This runs the same check CI runs, at the point where fixing it is free.
#
# It is fast on purpose -- about a fifth of a second -- because a hook that
# costs a minute is a hook that gets --no-verify'd. See the FINDINGS.md note
# below for the one check it leaves to CI.
#
# It checks the STAGED tree, not the working tree, for two reasons: that is
# what CI will see, and a second session often has its own uncommitted work
# in this project -- including in these two generated files. So the staged
# files are materialised into a temporary directory and the generators run
# there. Nothing in the working tree is read for the answer and nothing in
# it is written.
#
# Installed by pointing core.hooksPath at this directory:
#     git config core.hooksPath .githooks
set -e

E3=projects/09-e3-engine
git diff --cached --name-only | grep -q "^$E3/" || exit 0

PY=$(command -v python3 || command -v python) || exit 0
TMP=$(mktemp -d) || exit 0
trap 'rm -rf "$TMP"' EXIT

# The staged copy of the project, minus the scanned reports, which are large
# and which no generator reads.
git ls-files -- "$E3" ":!$E3/sources" > "$TMP/paths" || exit 0
[ -s "$TMP/paths" ] || exit 0
git checkout-index --prefix="$TMP/tree/" --stdin < "$TMP/paths"

# The staged copies of the two documents, read before leaving the repository.
for f in README.md FINDINGS.md; do
  git cat-file blob ":$E3/$f" > "$TMP/staged-$f" || {
    echo "pre-commit: $E3/$f is not in the index; commit refused." >&2; exit 1; }
done

# core.hooksPath may be absolute or relative to the repository root.
HOOKS=$(git config core.hooksPath)
case "$HOOKS" in
  /*) : ;;
  *)  HOOKS=$(git rev-parse --show-toplevel)/$HOOKS ;;
esac
[ -f "$HOOKS/findings-index-check.py" ] || {
  echo "pre-commit: cannot find $HOOKS/findings-index-check.py; commit refused." >&2
  exit 1; }
cd "$TMP/tree/$E3"

# README.md is regenerated in full: it costs about a tenth of a second.
"$PY" tools/build_readme.py >/dev/null 2>&1 || { echo "pre-commit: tools/build_readme.py failed on the staged tree; commit refused." >&2; exit 1; }

STALE=
cmp -s "$TMP/staged-README.md" README.md || STALE="$STALE $E3/README.md"

# FINDINGS.md is not: `tools/build_findings.py` imports the verification
# solvers to rank the disagreements, and that import runs them -- two minutes,
# which no one would keep in front of a commit. The half that goes stale on an
# ordinary commit is the index of numbered findings, and that is derived
# straight from the STEP0 files in milliseconds. The ranked half moves when
# solver code or data moves, and is regenerated by the run that produced those
# numbers; CI owns it.
"$PY" "$HOOKS/findings-index-check.py" . || STALE="$STALE $E3/FINDINGS.md"

[ -n "$STALE" ] || exit 0

echo >&2
echo "pre-commit: this commit would leave a generated document stale." >&2
echo >&2
for f in $STALE; do echo "    $f" >&2; done
echo >&2
echo "Regenerate and stage them, from $E3:" >&2
echo >&2
echo "    python3 tools/build_readme.py && python3 tools/build_findings.py" >&2
echo "    git add$STALE" >&2
echo >&2
echo "If another session also has these files open, regenerate in a clean" >&2
echo "worktree instead and stage the result, rather than overwriting theirs." >&2
echo "To commit anyway:  git commit --no-verify" >&2
echo >&2
exit 1
