.DS_Store
.env*.local
.env*

# JetBrains IDE
.idea/

# ── Project simulation output ───────────────────────────────────────────────
# Commit the inputs (case dictionaries, scripts, geometry) and the figures.
# Everything below regenerates from those, and gets large fast.
projects/**/case/[0-9]*
!projects/**/case/0/
projects/**/constant/polyMesh/
projects/**/*.foam
projects/**/log.*
projects/**/processor*/
projects/**/postProcessing/
*.vtk
*.vtu
*.vtm
*.pvsm
*.cgns
*.msh
*.FCStd1

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
projects/**/exports/*.iges

# CAD-Projects is its own repository (github.com/Itsvkid/CAD-Projects),
# checked out inside this one. Ignore it here rather than committing a
# gitlink to it.
CAD-Projects/

# PF-09 reference PDFs: fetched by fetch-sources.sh, public domain, not committed
projects/09-e3-engine/sources/

# PF-09 Stage G: generated CAD and build logs. Both are reproducible with
# `python build.py --export`, and the STEP set is 132 MB.
projects/09-e3-engine/exports/
projects/09-e3-engine/build/

# PF-09 Stage C4: CFD run directories. Regenerated by cfd/run_shocktube.sh;
# the case setup comes from the OpenFOAM image's own tutorials.
projects/09-e3-engine/cfd/run/
